# HTML e pagine: mai in cache lunga, altrimenti gli aggiornamenti
# del sito restano invisibili ai visitatori che tornano.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Asset con nome fisso: cache breve lato browser, Cloudflare li serve
# comunque dalla CDN. Passa a 1 anno solo con filename versionati.
/css/*
  Cache-Control: public, max-age=3600

/img/*
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# Le chiamate dello strumento di verifica non vanno mai in cache
/api/*
  Cache-Control: no-store

# I moduli JavaScript dello strumento devono essere serviti come tali
/verifica/*.js
  Content-Type: text/javascript; charset=utf-8
