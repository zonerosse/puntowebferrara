# HTML e pagine: mai in cache lunga, altrimenti gli aggiornamenti
# del sito restano invisibili ai visitatori che tornano.
/*
  Cache-Control: public, max-age=0, must-revalidate
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Il foglio di stile ha il nome con l'impronta del contenuto
# (style.min.<hash>.css): se cambia il CSS, cambia l'indirizzo, e il
# browser scarica il file nuovo perche' non l'ha mai visto.
#
# Per questo un anno di cache qui e' sicuro, ed e' anzi quello che si
# vuole: il file vecchio nessuno lo chiedera' piu'. Prima il nome era
# fisso e ogni modifica al CSS richiedeva un purge a mano su Cloudflare.
#
# immutable dice al browser di non ricontrollare nemmeno: quel contenuto,
# a quell'indirizzo, non puo' cambiare per definizione.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

/*.ico
  Cache-Control: public, max-age=604800

# Le chiamate dello strumento di verifica non vanno mai in cache
/api/*
  Cache-Control: no-store

# I moduli JavaScript dello strumento devono essere serviti come tali
/sottosopra/*.js
  Content-Type: text/javascript; charset=utf-8
